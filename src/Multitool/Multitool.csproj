<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>FoxMultitool</AssemblyName>
    <Product>Fox Multitool</Product>
    <Title>Fox Multitool</Title>
    <Company>FoxMultitool</Company>
    <Copyright>Copyright © 2026 FoxMultitool</Copyright>
    <Description>Fox Multitool — Windows toolbox (network, security, utilities)</Description>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\fox.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\fox.png" />
  </ItemGroup>

</Project>
