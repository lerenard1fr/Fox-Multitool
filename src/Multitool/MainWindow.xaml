<Window x:Class="Multitool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fox Multitool" Height="700" Width="1080"
        WindowStartupLocation="CenterScreen" Icon="Assets/fox.png"
        Background="{DynamicResource BgMain}" Foreground="{DynamicResource FgMain}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Grid.Row="0" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderCol}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🦊" FontSize="26" VerticalAlignment="Center"/>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="FOX MULTITOOL" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                            <Border Background="{DynamicResource BgHover}" CornerRadius="8" Padding="6,1" HorizontalAlignment="Left" Margin="0,3,0,0">
                                <TextBlock Text="v0.5.0" FontSize="10" Foreground="{DynamicResource FgMuted}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <Separator Margin="0,12"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button x:Name="BtnSecHub" Content="🧰  All Tools" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                    <Button x:Name="BtnSettings" Content="⚙️  Options" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Expander x:Name="ExpInfo" Header="🔎  Information Gathering" IsExpanded="True">
                            <StackPanel>
                                <Button x:Name="BtnNetwork" Content="Base IP / Ping / Ports" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                                <Button x:Name="BtnNmapScan" Content="Nmap Scan" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                                <Button x:Name="BtnDns" Content="DNS / NS Lookup" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                                <Button x:Name="BtnNetExtra" Content="Traceroute / ARP / Netstat" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                                <Button x:Name="BtnOsint" Content="IP Lookup" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                                <Button x:Name="BtnSecAmass" Content="Amass" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                                <Button x:Name="BtnSecHarvester" Content="theHarvester" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="ExpVuln" Header="🛡️  Vulnerability Analysis" IsExpanded="False">
                            <StackPanel>
                                <Button x:Name="BtnSecNessus" Content="Nessus" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                                <Button x:Name="BtnSecNikto" Content="Nikto" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="ExpWeb" Header="🌍  Web Application Analysis" IsExpanded="False">
                            <StackPanel>
                                <Button x:Name="BtnSecBurp" Content="Burp Suite" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                                <Button x:Name="BtnSecSqlmap" Content="sqlmap" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                                <Button x:Name="BtnSecGobuster" Content="Gobuster" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                                <Button x:Name="BtnSecFfuf" Content="ffuf" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="ExpPass" Header="🔑  Password Attacks" IsExpanded="False">
                            <StackPanel>
                                <Button x:Name="BtnSecJohn" Content="John the Ripper" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                                <Button x:Name="BtnSecHashcat" Content="Hashcat" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                                <Button x:Name="BtnSecHydra" Content="Hydra" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="ExpWifi" Header="📡  Wireless Attacks" IsExpanded="False">
                            <StackPanel>
                                <Button x:Name="BtnSecAircrack" Content="Aircrack-ng" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="ExpSniff" Header="👃  Sniffing &amp; Spoofing" IsExpanded="False">
                            <StackPanel>
                                <Button x:Name="BtnSecWireshark" Content="Wireshark" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                                <Button x:Name="BtnSecBettercap" Content="Bettercap" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                                <Button x:Name="BtnSecResponder" Content="Responder" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                                <Button x:Name="BtnSecNcat" Content="Netcat (ncat)" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="ExpExploit" Header="💥  Exploitation Tools" IsExpanded="False">
                            <StackPanel>
                                <Button x:Name="BtnSecMetasploit" Content="Metasploit" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="ExpSocial" Header="🕵️  Social Engineering" IsExpanded="False">
                            <StackPanel>
                                <Button x:Name="BtnSecMaltego" Content="Maltego" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                                <Button x:Name="BtnSecSherlock" Content="Sherlock" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="ExpSystem" Header="🖥️  System" IsExpanded="False">
                            <StackPanel>
                                <Button x:Name="BtnSystem" Content="Info / Process / Clean" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="ExpGen" Header="⚙️  Generators" IsExpanded="False">
                            <StackPanel>
                                <Button x:Name="BtnGenerator" Content="Pass / GUID / Hash" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24">
            <ContentControl x:Name="MainContent"/>
        </ScrollViewer>

        <Border Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderCol}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                <Ellipse x:Name="DotNmap" Width="10" Height="10" Fill="Gray" Margin="0,0,6,0"/>
                <TextBlock x:Name="TxtStatus" Text="Checking tools..." FontSize="11" Foreground="{DynamicResource FgMuted}"/>
                <TextBlock Text="  •  C# WPF .NET 9" FontSize="11" Foreground="{DynamicResource FgMuted}" Opacity="0.7"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
