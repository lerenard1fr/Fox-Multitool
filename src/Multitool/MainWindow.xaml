<Window x:Class="Multitool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fox Multitool" Height="700" Width="1080"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117" Foreground="#E6EDF3">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,1,0">
            <DockPanel Margin="14">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🦊" FontSize="26" VerticalAlignment="Center"/>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="FOX MULTITOOL" FontSize="18" FontWeight="Bold" Foreground="#FF7A00"/>
                            <Border Background="#21262D" CornerRadius="8" Padding="6,1" HorizontalAlignment="Left" Margin="0,3,0,0">
                                <TextBlock Text="v0.4.0" FontSize="10" Foreground="#8B949E"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <Separator Margin="0,12" Background="#30363D"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Expander Header="🌐  Réseau" IsExpanded="True">
                            <StackPanel>
                                <Button x:Name="BtnNetwork" Content="Base IP / Ping / Ports" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                                <Button x:Name="BtnNmapScan" Content="Nmap Scan" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                                <Button x:Name="BtnDns" Content="DNS / NS Lookup" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                                <Button x:Name="BtnNetExtra" Content="Tracert / ARP / Netstat" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                            </StackPanel>
                        </Expander>
                        <Expander Header="🖥️  Système" IsExpanded="False">
                            <StackPanel>
                                <Button x:Name="BtnSystem" Content="Infos / Process / Clean" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                            </StackPanel>
                        </Expander>
                        <Expander Header="🔍  OSINT" IsExpanded="False">
                            <StackPanel>
                                <Button x:Name="BtnOsint" Content="IP Lookup" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                            </StackPanel>
                        </Expander>
                        <Expander Header="⚙️  Générateurs" IsExpanded="False">
                            <StackPanel>
                                <Button x:Name="BtnGenerator" Content="Pass / GUID / Hash" Style="{StaticResource SubMenuButton}" Click="Nav_Click"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24">
            <ContentControl x:Name="MainContent"/>
        </ScrollViewer>

        <Border Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                <Ellipse x:Name="DotNmap" Width="10" Height="10" Fill="Gray" Margin="0,0,6,0"/>
                <TextBlock x:Name="TxtStatus" Text="Vérification outils..." FontSize="11" Foreground="#8B949E"/>
                <TextBlock Text="  •  C# WPF .NET 9" FontSize="11" Foreground="#484F58"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
