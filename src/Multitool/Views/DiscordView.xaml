<UserControl x:Class="Multitool.Views.DiscordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Discord" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock x:Name="TxtWarn" FontSize="12" Foreground="#8B949E" Margin="0,0,0,12" TextWrapping="Wrap"/>
        <GroupBox x:Name="GrpSend" Header="Webhook sender">
            <StackPanel Margin="10">
                <TextBox x:Name="InHook" AcceptsReturn="False"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBox x:Name="InUser" Width="180"/>
                    <Button Style="{StaticResource ActionButton}" x:Name="BtnSend" Content="Send" Width="100" Margin="8,0,0,0" Click="BtnSend_Click"/>
                </StackPanel>
                <TextBox x:Name="InMsg" Margin="0,8,0,0" Height="70" AcceptsReturn="True"/>
                <TextBox x:Name="OutSend" Margin="0,8,0,0" Height="40" IsReadOnly="True" AcceptsReturn="True"/>
            </StackPanel>
        </GroupBox>
        <GroupBox x:Name="GrpLookup" Header="Lookup">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="InId" Width="240"/>
                    <Button Style="{StaticResource ActionButton}" x:Name="BtnId" Content="Decode" Width="90" Margin="8,0,0,0" Click="BtnId_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBox x:Name="InInvite" Width="240"/>
                    <Button Style="{StaticResource ActionButton}" x:Name="BtnInvite" Content="Check" Width="90" Margin="8,0,0,0" Click="BtnInvite_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Style="{StaticResource SecondaryButton}" x:Name="BtnHookInfo" Content="Webhook info" Width="130" Click="BtnHookInfo_Click"/>
                </StackPanel>
                <TextBox x:Name="OutLookup" Margin="0,8,0,0" Height="180" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas"/>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
