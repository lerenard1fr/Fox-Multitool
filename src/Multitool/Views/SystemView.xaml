<UserControl x:Class="Multitool.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock x:Name="TxtTitle" Text="System / Utilities" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
        <GroupBox x:Name="GrpInfo" Header="System info">
            <StackPanel Margin="8">
                <Button Style="{StaticResource ActionButton}" x:Name="BtnInfo" Content="Show" Width="120" HorizontalAlignment="Left" Click="BtnInfo_Click"/>
                <TextBox x:Name="OutInfo" Margin="0,8,0,0" Height="140" IsReadOnly="True" AcceptsReturn="True"/>
            </StackPanel>
        </GroupBox>
        <GroupBox x:Name="GrpProc" Header="Processes (top RAM)">
            <StackPanel Margin="8">
                <Button Style="{StaticResource ActionButton}" x:Name="BtnProc" Content="List" Width="120" HorizontalAlignment="Left" Click="BtnProc_Click"/>
                <TextBox x:Name="OutProc" Margin="0,8,0,0" Height="180" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas"/>
            </StackPanel>
        </GroupBox>
        <GroupBox x:Name="GrpClean" Header="%TEMP% cleanup">
            <StackPanel Margin="8">
                <Button Style="{StaticResource ActionButton}" x:Name="BtnClean" Content="Clean" Width="120" HorizontalAlignment="Left" Click="BtnClean_Click"/>
                <TextBox x:Name="OutClean" Margin="0,8,0,0" Height="60" IsReadOnly="True" AcceptsReturn="True"/>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
