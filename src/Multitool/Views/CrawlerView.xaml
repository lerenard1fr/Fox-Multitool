<UserControl x:Class="Multitool.Views.CrawlerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="URL Discovery Crawler" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock x:Name="TxtSub" FontSize="12" Foreground="#8B949E" Margin="0,0,0,12" TextWrapping="Wrap"/>
        <GroupBox x:Name="GrpMain" Header="Crawl">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="InUrl" Width="300" Text="https://example.com"/>
                    <TextBox x:Name="InDepth" Width="50" Margin="8,0,0,0" Text="1"/>
                    <CheckBox x:Name="ChkSame" IsChecked="True" Margin="8,6,0,0"/>
                    <Button Style="{StaticResource ActionButton}" x:Name="BtnCrawl" Width="110" Margin="8,0,0,0" Click="BtnCrawl_Click"/>
                </StackPanel>
                <TextBox x:Name="OutUrls" Margin="0,8,0,0" Height="300" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Style="{StaticResource SecondaryButton}" x:Name="BtnExport" Content="💾 Export (.txt) → data/" Width="210" Click="BtnExport_Click"/>
                    <TextBlock x:Name="TxtExport" Margin="8,6,0,0" FontSize="11" Foreground="#8B949E"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
