<UserControl x:Class="Multitool.Views.InstagramView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Instagram Profile Lookup" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock x:Name="TxtSub" FontSize="12" Foreground="#8B949E" Margin="0,0,0,12" TextWrapping="Wrap"/>
        <GroupBox x:Name="GrpMain" Header="Profile">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="InUser" Width="240" Text="instagram"/>
                    <Button Style="{StaticResource ActionButton}" x:Name="BtnOpen" Content="Open" Width="110" Margin="8,0,0,0" Click="BtnOpen_Click"/>
                </StackPanel>
                <TextBlock x:Name="TxtNote" Margin="0,8,0,0" FontSize="11" Foreground="#8B949E" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
