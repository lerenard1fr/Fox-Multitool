<UserControl x:Class="Multitool.Views.NmapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Nmap / DNS" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
        <GroupBox Header="Nmap — état">
            <StackPanel Margin="8">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Vérifier Nmap" Width="120" Click="BtnCheck_Click"/>
                    <TextBlock x:Name="TxtNmapStatus" Margin="8,6,0,0" TextWrapping="Wrap" Width="500"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="BtnWinget" Content="⬇ Installer via winget" Width="170" Click="BtnWinget_Click"/>
                    <Button x:Name="BtnDownload" Content="⬇ Télécharger setup.exe" Width="190" Margin="8,0,0,0" Click="BtnDownload_Click"/>
                    <Button Content="Ouvrir nmap.org" Width="120" Margin="8,0,0,0" Click="BtnOpenPage_Click"/>
                </StackPanel>
                <ProgressBar x:Name="DlProgress" Height="8" Margin="0,8,0,0" Minimum="0" Maximum="100"/>
                <TextBox x:Name="OutInstall" Margin="0,8,0,0" Height="80" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas"/>
                <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="#8B949E"
                           Text="Winget = auto. Setup.exe = téléchargé dans %TEMP% puis lancé (admin requis pour Npcap)."/>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Nmap — scan (outil connu nmap)">
            <StackPanel Margin="8">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="InTarget" Width="220" Text="127.0.0.1"/>
                    <TextBox x:Name="InPorts" Width="120" Margin="8,0,0,0" Text="80,443,3389"/>
                </StackPanel>
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Rapide -F" Width="90" Margin="0,0,8,8" Click="BtnQuick_Click"/>
                    <Button Content="Services -sV" Width="100" Margin="0,0,8,8" Click="BtnService_Click"/>
                    <Button Content="OS -O" Width="80" Margin="0,0,8,8" Click="BtnOs_Click"/>
                    <Button Content="Complet -A" Width="90" Margin="0,0,8,8" Click="BtnFull_Click"/>
                    <Button Content="Ping -sn" Width="80" Margin="0,0,8,8" Click="BtnPingSweep_Click"/>
                    <Button Content="Ports -p" Width="80" Margin="0,0,8,8" Click="BtnPorts_Click"/>
                </WrapPanel>
                <TextBox x:Name="OutNmap" Height="200" IsReadOnly="True" AcceptsReturn="True"
                         FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="NS / DNS Lookup (outil connu nslookup)">
            <StackPanel Margin="8">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="InDns" Width="220" Text="google.com"/>
                    <Button Content="NS" Width="50" Margin="8,0,0,0" Click="BtnNs_Click"/>
                    <Button Content="MX" Width="50" Margin="8,0,0,0" Click="BtnMx_Click"/>
                    <Button Content="TXT" Width="50" Margin="8,0,0,0" Click="BtnTxt_Click"/>
                    <Button Content="A" Width="50" Margin="8,0,0,0" Click="BtnA_Click"/>
                    <Button Content="PTR" Width="50" Margin="8,0,0,0" Click="BtnPtr_Click"/>
                </StackPanel>
                <TextBox x:Name="OutDns" Margin="0,8,0,0" Height="160" IsReadOnly="True"
                         AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
