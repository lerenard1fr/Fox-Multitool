<UserControl x:Class="Multitool.Views.EmailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Email Tracker / Lookup" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock x:Name="TxtSub" FontSize="12" Foreground="#8B949E" Margin="0,0,0,12" TextWrapping="Wrap"/>
        <GroupBox x:Name="GrpMain" Header="Email">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="InEmail" Width="280" Text="someone@example.com"/>
                    <Button Style="{StaticResource ActionButton}" x:Name="BtnCheck" Content="Check" Width="90" Margin="8,0,0,0" Click="BtnCheck_Click"/>
                </StackPanel>
                <TextBox x:Name="OutEmail" Margin="0,8,0,0" Height="260" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
