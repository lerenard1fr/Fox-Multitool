<UserControl x:Class="Multitool.Views.WalletView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Wallet Tracker (BTC)" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock x:Name="TxtSub" FontSize="12" Foreground="#8B949E" Margin="0,0,0,12" TextWrapping="Wrap"/>
        <GroupBox x:Name="GrpMain" Header="Bitcoin">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="InAddr" Width="380"/>
                    <Button Style="{StaticResource ActionButton}" x:Name="BtnCheck" Content="Check" Width="90" Margin="8,0,0,0" Click="BtnCheck_Click"/>
                </StackPanel>
                <TextBox x:Name="OutWallet" Margin="0,8,0,0" Height="160" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas"/>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
