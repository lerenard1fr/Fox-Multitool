<UserControl x:Class="Multitool.Views.PhoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Phone Number Lookup" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock x:Name="TxtSub" FontSize="12" Foreground="#8B949E" Margin="0,0,0,12" TextWrapping="Wrap"/>
        <GroupBox x:Name="GrpMain" Header="Phone">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="InPhone" Width="220" Text="+33612345678"/>
                    <TextBox x:Name="InRegion" Width="60" Margin="8,0,0,0" Text="FR"/>
                    <Button Style="{StaticResource ActionButton}" x:Name="BtnParse" Content="Check" Width="90" Margin="8,0,0,0" Click="BtnParse_Click"/>
                </StackPanel>
                <TextBox x:Name="OutPhone" Margin="0,8,0,0" Height="220" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas"/>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
