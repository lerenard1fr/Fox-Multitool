<UserControl x:Class="Multitool.Views.ClonerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Website Cloner" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock x:Name="TxtSub" FontSize="12" Foreground="#8B949E" Margin="0,0,0,12" TextWrapping="Wrap"/>
        <GroupBox x:Name="GrpMain" Header="Mirror">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="InUrl" Width="300" Text="https://example.com"/>
                    <Button Style="{StaticResource ActionButton}" x:Name="BtnClone" Content="Clone" Width="110" Margin="8,0,0,0" Click="BtnClone_Click"/>
                </StackPanel>
                <TextBox x:Name="OutClone" Margin="0,8,0,0" Height="160" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas"/>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
