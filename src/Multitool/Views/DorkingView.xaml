<UserControl x:Class="Multitool.Views.DorkingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Dorking Query Engine" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock x:Name="TxtSub" FontSize="12" Foreground="#8B949E" Margin="0,0,0,12" TextWrapping="Wrap"/>
        <GroupBox x:Name="GrpMain" Header="Dorks">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="InDomain" Width="240" Text="example.com"/>
                    <ComboBox x:Name="EngineBox" Width="140" Margin="8,0,0,0"/>
                </StackPanel>
                <WrapPanel x:Name="DorkPanel" Margin="0,10,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBox x:Name="InCustom" Width="380"/>
                    <Button Style="{StaticResource ActionButton}" x:Name="BtnGo" Content="Search" Width="90" Margin="8,0,0,0" Click="BtnGo_Click"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
