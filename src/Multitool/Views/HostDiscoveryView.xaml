<UserControl x:Class="Multitool.Views.HostDiscoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Host Discovery" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock x:Name="TxtSub" FontSize="12" Foreground="#8B949E" Margin="0,0,0,12" TextWrapping="Wrap"/>
        <GroupBox x:Name="GrpMain" Header="Ping sweep">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="InCidr" Width="200" Text="192.168.1.0/24"/>
                    <Button Style="{StaticResource ActionButton}" x:Name="BtnDiscover" Width="110" Margin="8,0,0,0" Click="BtnDiscover_Click"/>
                </StackPanel>
                <TextBox x:Name="OutHosts" Margin="0,8,0,0" Height="300" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Style="{StaticResource SecondaryButton}" x:Name="BtnExport" Content="💾 Export (.txt) → data/" Width="210" Click="BtnExport_Click"/>
                    <TextBlock x:Name="TxtExport" Margin="8,6,0,0" FontSize="11" Foreground="#8B949E"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
